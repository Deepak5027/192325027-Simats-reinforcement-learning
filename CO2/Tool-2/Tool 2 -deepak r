def env(d_idx, m_idx):
base_riders = [20, 50, 90][d_idx] price = MULT[m_idx]
# higher price -> fewer riders accept (uncertain elasticity)
accept = base_riders * max(0.1, 1.0 - 0.35 * (price - 1.0)) * np.random.uniform(0.8, 1.2)
