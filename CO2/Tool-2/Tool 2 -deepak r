best = int(np.argmax(Q[d]))
print(f" Demand {DEMAND[d]:<4} -> price {MULT[best]}x  (Q={Q[d, best]:.0f})") print("\nEnvironmental uncertainty (random rider acceptance) is absorbed by") print("averaging returns; fairness penalty curbs surge when demand is low.") OUTPUT:
