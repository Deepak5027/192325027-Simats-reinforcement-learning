d = alpha*(r + gamma*np.max(Q[s2]) - Q[s,a]); Q[s,a]+=d maxd = max(maxd, abs(d)); s = s2
if done: break
print(f" episodes {block*50+1:>3}-{block*50+50}: max change = {maxd:.4f}") print("\nFinal Q-table (rows=state 0..5, cols=[left,right]):")
