+d}")
s = s2
if done or steps > 30: break
print(f"{name:<16} cumulative reward (return) = {total:>4} in {steps} steps") return total

np.random.seed(0)
run(lambda s: 1, "Always-right", trace=True)	# optimal run(lambda s: np.random.randint(2), "Random")		# weaker
